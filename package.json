{
  "name": "huddle60",
  "version": "0.1.0",
  "private": true,
  "description": "huddle60: a 60-second huddle between PO, DEV and AI on GitHub. Gemini planning, hash-locked requirements and PR gates (AI-DLC).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "huddle60": "dist/cli.js"
  },
  "files": [
    "dist",
    "templates",
    "ui"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm test && npm run format:check",
    "huddle60": "node dist/cli.js",
    "planner:start": "node dist/planner-server.js"
  },
  "dependencies": {
    "@google-cloud/firestore": "^9.4.0",
    "@google-cloud/tasks": "^7.3.1",
    "@google/genai": "^2.32.0",
    "@octokit/auth-app": "^8.3.1",
    "@octokit/plugin-retry": "^8.1.1",
    "@octokit/rest": "^22.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
