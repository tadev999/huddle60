# Copy to .env for local runs. Never commit real values.
PORT=8080
GITHUB_APP_ID=123456
# Paste the PEM with literal \n line breaks, or load it from a file in your shell.
GITHUB_APP_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----
GITHUB_WEBHOOK_SECRET=replace-with-a-long-random-secret
GEMINI_API_KEY=replace-me
AI_DLC_MODEL=gemini-2.5-flash
AI_DLC_PLANNER_ENABLED=true
AI_DLC_MAX_REVISIONS=10
# Local: memory + inline. Production: firestore + cloud-tasks.
AI_DLC_STORE=memory
AI_DLC_QUEUE=inline
# Required when AI_DLC_QUEUE=cloud-tasks
# GCP_PROJECT=my-project
# GCP_LOCATION=asia-southeast1
# CLOUD_TASKS_QUEUE=ai-dlc-planner
# AI_DLC_WORKER_URL=https://ai-dlc-planner-xxxx.a.run.app/tasks/planner
# AI_DLC_TASK_TOKEN=replace-with-at-least-32-random-characters
