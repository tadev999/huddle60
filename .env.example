# Gemini API key for CLI commands such as plan-preview and knowledge.
# `huddle60 ui` ignores server credentials: enter GitHub/Gemini keys in browser Settings.
GEMINI_API_KEY=your-gemini-api-key
# AI_DLC_MODEL=gemini-3.8-flash

# Optional GitHub token for CLI commands (defaults to `gh auth token`)
# GITHUB_TOKEN=ghp_...

# Local and SaaS use the same thin server and browser engine; no mode flag is needed.
# Run `npm run build` to produce ui/engine.js.
# "Remember on this device" is opt-in and stores credentials in localStorage for this origin.
# ALLOWED_HOSTS=huddle60.app
# OAuth is optional. For local OAuth, register the actual callback URL, e.g.
# http://127.0.0.1:4317/api/auth/github/callback
# GITHUB_CLIENT_ID=...
# GITHUB_CLIENT_SECRET=...
