# Optional Gemini API key for planning in `huddle60 ui` (PO only)
# macOS can also store this securely in Keychain: security add-generic-password -s huddle60-gemini -a $USER -w
GEMINI_API_KEY=your-gemini-api-key
# AI_DLC_MODEL=gemini-3.8-flash

# Optional GitHub token (defaults to `gh auth token` automatically)
# GITHUB_TOKEN=ghp_...
